# Same Supabase project as the Nuxt app (kidstory/.env) — copy the values across.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by POST/PATCH/DELETE /stories (sent as the X-API-Key header).
# Any long random string, e.g. `openssl rand -hex 32`. Leave blank to disable writes.
KIDSTORY_API_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Distance service — all optional, these are the defaults. Both are free, keyless
# OpenStreetMap services; self-host them for anything beyond light testing.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GEO_USER_AGENT=kidstory-api/0.1 (https://github.com/ziagit)
GEO_TIMEOUT_SECONDS=15
