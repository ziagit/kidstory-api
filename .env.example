# Same Supabase project as the Nuxt app (kidstory/.env) — copy the values across.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by POST/PATCH/DELETE /stories and POST /stories/generate
# (sent as the X-API-Key header). Any long random string, e.g. `openssl rand -hex 32`.
# Leave blank to disable writes and generation.
KIDSTORY_API_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Claude API key (from the Claude Console) used by POST /stories/generate.
# Blank disables generation. ANTHROPIC_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# The same key runs the story and social agents (POST /agents/story, /agents/social).

# Accounts the social agent posts to. A platform left blank is skipped.
# Same values the Nuxt app used before posting moved here (see SOCIAL-SETUP.md there).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public origin of the Nuxt site, for story links in posts.
SITE_URL=https://storyland-sigma.vercel.app

# Bearer token required on /mcp. Blank leaves /mcp open but read-only...
MCP_BEARER_TOKEN=
# ...unless this is 1, which registers generate/create/update/delete on the
# open endpoint too. Anyone who knows the URL can then change the catalog.
# Needed for ChatGPT's connector, which can't send a bearer token.
MCP_PUBLIC_WRITES=0

# Comma-separated public hostnames this API is served under, e.g.
# kidstory-api.vercel.app — enables DNS-rebinding protection on /mcp.
PUBLIC_HOSTS=

# Run /mcp without server-side sessions (required on serverless hosts). Defaults
# to on when Vercel's VERCEL env var is present; set explicitly elsewhere.
# MCP_STATELESS=1
