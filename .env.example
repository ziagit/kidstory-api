# Same Supabase project as the Nuxt app (kidstory/.env) — copy the values across.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by POST/PATCH/DELETE /stories and POST /stories/generate
# (sent as the X-API-Key header). Any long random string, e.g. `openssl rand -hex 32`.
# Leave blank to disable writes and generation.
KIDSTORY_API_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Story model: any OpenAI-compatible chat endpoint, including the /v1 path.
# Blank disables POST /stories/generate.
#   Kidstory's own model (deploy/model-space/ on a VPS):
#     STORY_MODEL_URL=https://<model-host>/v1  STORY_MODEL_API_KEY=<its LLAMA_API_KEY>
#     STORY_MODEL_NAME=kidstory-story-model     STORY_MODEL_MAX_TOKENS=450
#   Stand-in until then — OpenRouter's free model:
#     STORY_MODEL_URL=https://openrouter.ai/api/v1  STORY_MODEL_API_KEY=<OpenRouter key>
#     STORY_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free  STORY_MODEL_MAX_TOKENS=1200
STORY_MODEL_URL=
STORY_MODEL_API_KEY=
STORY_MODEL_NAME=kidstory-story-model
STORY_MODEL_MAX_TOKENS=450

# Bearer token required on /mcp. Blank leaves /mcp open but read-only...
MCP_BEARER_TOKEN=
# ...unless this is 1, which registers generate/create/update/delete on the
# open endpoint too. Anyone who knows the URL can then change the catalog.
# Needed for ChatGPT's connector, which can't send a bearer token.
MCP_PUBLIC_WRITES=0

# Comma-separated public hostnames this API is served under, e.g.
# kidstory-api.vercel.app — enables DNS-rebinding protection on /mcp.
PUBLIC_HOSTS=

# Run /mcp without server-side sessions (required on serverless hosts). Defaults
# to on when Vercel's VERCEL env var is present; set explicitly elsewhere.
# MCP_STATELESS=1
